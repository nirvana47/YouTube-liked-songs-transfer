# Copy this file to .env, then replace the placeholder values.
#
# These come from the single Google Cloud OAuth client you create once.
# The same client ID/secret is used to authorize both account A and account B.
YTMUSICAPI_CLIENT_ID="paste-your-google-oauth-client-id-here"
YTMUSICAPI_CLIENT_SECRET="paste-your-google-oauth-client-secret-here"
